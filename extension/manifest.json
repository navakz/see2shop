{
  "manifest_version": 3,
  "name": "See2Shop",
  "version": "0.1.0",
  "description": "See something online. Find something useful.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_title": "See2Shop"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content/youtube.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/results/results.html",
        "src/results/results.css",
        "src/results/results.js"
      ],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
